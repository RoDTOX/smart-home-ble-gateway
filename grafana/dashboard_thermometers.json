      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "default"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (device_mac) device_name AS \"Room\", COALESCE(ble_name, CASE WHEN device_mac = 'A4:C1:38:84:A1:E8' THEN 'ATC_84A1E8' WHEN device_mac = 'A4:C1:38:A4:C1:DD' THEN 'ATC_A4C1DD' WHEN device_mac = 'A4:C1:38:94:0F:44' THEN 'ATC_940F44' ELSE 'ATC_Thermometer' END) AS \"Bluetooth Name (Flasher Connection)\", COALESCE(hw_ver, 'LYWSD03MMC (B1.7)') AS \"Hardware Model\", COALESCE(sw_ver, 'PVVX v5.8') AS \"Firmware Version\", device_mac AS \"MAC Address\", COALESCE(protocol, 'BTHome v2') AS \"Protocol Format\", COALESCE(tx_interval, 10.0) || ' sec' AS \"Tx Interval\", battery_level || '%' AS \"Battery\", rssi || ' dBm' AS \"Signal (RSSI)\", recorded_at AS \"Last Telemetry\" FROM thermometer_telemetry WHERE device_name IN ($device) ORDER BY device_mac, recorded_at DESC",
          "refId": "A"
        }
      ],
      "title": "Unit Configuration & Hardware Status",
      "type": "table"
    },
